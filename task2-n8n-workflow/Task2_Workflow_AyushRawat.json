      "id": "5a6b7c8d-0013-4e5f-8a9b-000000000013",
      "name": "GitHub: search new repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
        64
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Transformation: keep only real, described, non-fork projects, rank by stars, keep the top N.\nconst cfg = $('Config').first().json;\nconst repos = $input.first().json.items ?? [];\nconst now = Date.now();\n\nconst top = repos\n  .filter(r => !r.fork && !r.archived && r.description)     // skip forks, archived and empty repos\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)  // most-starred first\n  .slice(0, cfg.topN)\n  .map((r, i) => {\n    const ageDays = Math.max(1, (now - Date.parse(r.created_at)) / 86400000);\n    return {\n      rank: i + 1,\n      fullName: r.full_name,\n      url: r.html_url,\n      description: r.description.length > 160 ? r.description.slice(0, 157) + '…' : r.description,\n      stars: r.stargazers_count,\n      starsPerDay: Math.round(r.stargazers_count / ageDays),\n      language: r.language ?? '—',\n      createdAt: r.created_at.slice(0, 10),\n    };\n  });\n\nif (top.length === 0) {\n  // An empty brief is abnormal (typo in the topic, API change...): fail loudly so the Error Workflow alerts.\n  throw new Error(`GitHub returned no usable repositories for topic \"${cfg.topic}\" in the last ${cfg.lookbackDays} days`);\n}\nreturn top.map(r => ({ json: r }));"
      },
      "id": "5a6b7c8d-0014-4e5f-8a9b-000000000014",
      "name": "Top 5 repos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -48
      ]
    },
