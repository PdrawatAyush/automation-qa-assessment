              "id": "5a6b7c8d-0015-4e5f-8a9b-000000000015",
              "leftValue": "={{ $json.stars }}",
              "rightValue": "={{ $('Config').first().json.starThreshold }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5a6b7c8d-0016-4e5f-8a9b-000000000016",
      "name": "IF: breakout?",
