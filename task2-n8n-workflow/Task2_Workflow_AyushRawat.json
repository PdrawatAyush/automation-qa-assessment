    {
      "parameters": {
        "jsCode": "// Build ONE Discord message: a header line + two embeds (breakout / rising).\nconst cfg = $('Config').first().json;\nconst repos = $input.all().map(i => i.json).sort((a, b) => b.stars - a.stars);\nconst breakout = repos.filter(r => r.tier === 'breakout');\nconst rising = repos.filter(r => r.tier === 'rising');\nconst n = new Intl.NumberFormat('en-US');\n\nconst breakoutText = breakout.map(r =>\n  `**[${r.fullName}](${r.url})** · ⭐ ${n.format(r.stars)} (+${n.format(r.starsPerDay)}/day) · ${r.language}\\n${r.description}\\n> ${r.readme}`\n).join('\\n\\n') || '_No repo crossed the threshold this time._';\n\nconst risingText = rising.map(r =>\n  `**[${r.fullName}](${r.url})** · ⭐ ${n.format(r.stars)} · ${r.language} — ${r.description}`\n).join('\\n') || `_Nothing else in the top ${cfg.topN}._`;\n\nreturn [{\n  json: {\n    content: `☀️ **Morning brief** — top ${repos.length} new GitHub repos tagged \\`${cfg.topic}\\` (created in the last ${cfg.lookbackDays} days): ${breakout.length} breakout (≥ ${n.format(cfg.starThreshold)} ⭐), ${rising.length} rising.`,\n    embeds: [\n      { title: `🔥 Breakout (${breakout.length})`, description: breakoutText.slice(0, 3500), color: 0xE8590C },\n      { title: `📈 Rising (${rising.length})`, description: risingText.slice(0, 2000), color: 0x1C7ED6,\n        footer: { text: `Source: GitHub Search API · n8n ${cfg.source} run · ${$now.toFormat('dd LLL yyyy HH:mm ZZZZ')}` } },\n    ],\n    stats: { total: repos.length, breakout: breakout.length, rising: rising.length, topic: cfg.topic, threshold: cfg.starThreshold },\n  },\n}];"
      },
