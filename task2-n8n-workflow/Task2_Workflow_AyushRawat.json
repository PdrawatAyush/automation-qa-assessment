      "id": "5a6b7c8d-0017-4e5f-8a9b-000000000017",
      "name": "GitHub: fetch README",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1200,
        -144
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Enrichment: turn the README into a one-paragraph teaser. If the README call failed\n// (\"Continue on fail\"), keep the repo in the digest and say so instead of dropping it.\nconst repo = $('Top 5 repos').item.json;\nlet readme = '_README unavailable_';\nif (!$json.error && $json.content) {\n  const markdown = Buffer.from($json.content, 'base64').toString('utf8');\n  readme = firstParagraph(markdown);\n}\nreturn { json: { ...repo, tier: 'breakout', readme } };\n\nfunction firstParagraph(md) {\n  const paragraph = md\n    .replace(/<!--[\\s\\S]*?-->/g, '')          // HTML comments\n    .replace(/<[^>]+>/g, ' ')                  // HTML tags\n    .replace(/!\\[[^\\]]*\\]\\([^)]*\\)/g, '')      // images and badges\n    .replace(/\\[([^\\]]*)\\]\\([^)]*\\)/g, '$1')   // links -> link text\n    .replace(/\\*\\*|__|`/g, '')                  // bold markers and inline code ticks\n    .split(/\\n\\s*\\n/)                           // paragraphs\n    .map(p => p.replace(/\\s+/g, ' ').trim())\n    .find(p => p.length > 60 && p.split(' ').length >= 8        // a real sentence, not a title\n      && !/^(#|\\||>|-{3,}|={3,})/.test(p)                      // not a heading, table, quote or rule\n      && (p.match(/[·|•]/g) ?? []).length < 3);                  // not a language switcher / nav bar\n  if (!paragraph) return '_README has no plain-text intro_';\n  return paragraph.length > 220 ? paragraph.slice(0, 217) + '…' : paragraph;\n}"
      },
      "id": "5a6b7c8d-0018-4e5f-8a9b-000000000018",
      "name": "Breakout card",
      "type": "n8n-nodes-base.code",
