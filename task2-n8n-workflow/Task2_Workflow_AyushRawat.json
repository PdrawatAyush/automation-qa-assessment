    },
    {
      "parameters": {
        "jsCode": "// The GitHub search failed even after 3 tries: tell the team instead of failing silently.\nconst cfg = $('Config').first().json;\nconst err = $input.first().json.error ?? $input.first().json;\nconst status = err.httpCode ?? err.status ?? err.statusCode ?? 'n/a';\nconst message = readableMessage(err);\nreturn [{\n  json: {\n    content: `⚠️ **Morning brief unavailable** — the GitHub search request failed after 3 attempts (HTTP ${status}: ${message}). No digest this run; the next scheduled run retries automatically.\\nTopic: \\`${cfg.topic}\\` · execution ${$execution.id}`,\n    httpStatus: String(status),\n    error: message,\n  },\n}];\n\n// n8n reports HTTP errors as: 404 - \"<response body as a JSON string>\". Pull out GitHub's own message.\nfunction readableMessage(e) {\n  const raw = String(e.message ?? e.description ?? 'unknown error');\n  const m = raw.match(/^\\d{3} - (\"[\\s\\S]*\")$/);\n  if (m) {\n    try { const body = JSON.parse(JSON.parse(m[1])); if (body && body.message) return String(body.message).slice(0, 300); } catch (_) { /* not JSON */ }\n  }\n  return raw.slice(0, 300);\n}"
      },
