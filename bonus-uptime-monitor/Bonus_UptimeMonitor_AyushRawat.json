    {
      "parameters": {
        "jsCode": "// Alert on CHANGES, not on every check: DOWN once, a reminder every 30 min while still down,\n// and RECOVERED when it comes back. The state lives in the Data Table \"uptime_state\", read when\n// this runs. (Workflow static data is NOT used: n8n snapshots it when an execution is created,\n// so a queued/overlapping run would decide on stale state and send a duplicate alert.)\nconst results = $('Collect results').first().json.results;\nconst row = $input.all().map(i => i.json).find(r => r.key === 'uptime');\nconst state = row?.state ? JSON.parse(row.state) : { targets: {}, since: new Date().toISOString() };\nconst REMIND_EVERY_MIN = 30;\nconst now = Date.now();\nconst alerts = [];\n\nfor (const r of results) {\n  const t = state.targets[r.name] = state.targets[r.name] ?? { status: 'up', checks: 0, upChecks: 0, times: [], incidents: 0, downMs: 0 };\n  t.checks++;\n  if (r.up) { t.upChecks++; t.times.push(r.ms); if (t.times.length > 400) t.times.shift(); }\n\n  if (!r.up && t.status === 'up') {\n    Object.assign(t, { status: 'down', downSince: now, lastAlertAt: now, incidents: t.incidents + 1 });\n    alerts.push(`🔴 **${r.name} is DOWN** — ${r.reason} (confirmed after 3 attempts)\\n${r.url}`);\n  } else if (!r.up && t.status === 'down' && now - t.lastAlertAt >= REMIND_EVERY_MIN * 60000) {\n    t.lastAlertAt = now;\n    alerts.push(`🔴 **${r.name} still DOWN** for ${minutes(now - t.downSince)} — ${r.reason}`);\n  } else if (r.up && t.status === 'down') {\n    const downFor = now - t.downSince;\n    Object.assign(t, { status: 'up', downMs: t.downMs + downFor, downSince: null });\n    alerts.push(`🟢 **${r.name} recovered** — HTTP 200 in ${r.ms} ms after ${minutes(downFor)} down`);\n  }\n  t.last = { status: r.status, ms: r.ms, at: r.checkedAt };\n}\n\nreturn [{\n  json: {\n    key: 'uptime',\n    state: JSON.stringify(state),\n    checked: results.length,\n    up: results.filter(r => r.up).length,\n    alertCount: alerts.length,\n    content: alerts.join('\\n\\n'),\n    results: results.map(r => `${r.name}: ${r.up ? `UP (${r.ms} ms)` : `DOWN (${r.reason})`}`),\n  },\n}];\n\nfunction minutes(ms) { const m = Math.round(ms / 60000); return m < 1 ? 'under a minute' : `${m} min`; }"
      },
