    {
      "parameters": {
        "jsCode": "// Daily report from the stats gathered by the 5-minute checks, then start a new period.\nconst row = $input.all().map(i => i.json).find(r => r.key === 'uptime');\nconst state = row?.state ? JSON.parse(row.state) : { targets: {} };\nconst now = Date.now();\nconst lines = Object.entries(state.targets).map(([name, t]) => {\n  const uptime = t.checks ? (100 * t.upChecks / t.checks).toFixed(2) + '%' : 'n/a';\n  const times = [...t.times].sort((a, b) => a - b);\n  const avg = times.length ? Math.round(times.reduce((a, b) => a + b, 0) / times.length) : '–';\n  const p95 = times.length ? times[Math.ceil(0.95 * times.length) - 1] : '–';\n  const max = times.length ? times[times.length - 1] : '–';\n  const downMin = Math.round((t.downMs + (t.status === 'down' ? now - t.downSince : 0)) / 60000);\n  return `${t.status === 'down' ? '🔴' : '🟢'} **${name}** — ${uptime} up (${t.upChecks}/${t.checks} checks) · avg ${avg} ms · p95 ${p95} ms · max ${max} ms · ${t.incidents} incident(s), ${downMin} min down`;\n});\nconst since = state.since ? DateTime.fromISO(state.since).setZone('Asia/Kolkata').toFormat('dd LLL HH:mm') : 'start';\nconst content = lines.length\n  ? `📊 **Daily uptime report — Conduit** (since ${since} IST)\\n${lines.join('\\n')}`\n  : '📊 **Daily uptime report — Conduit**: no checks recorded yet.';\n\n// New reporting period (current up/down status is kept).\nfor (const t of Object.values(state.targets)) {\n  Object.assign(t, { checks: 0, upChecks: 0, times: [], downMs: 0, incidents: t.status === 'down' ? 1 : 0 });\n  if (t.status === 'down') t.downSince = now;\n}\nstate.since = new Date(now).toISOString();\nreturn [{ json: { key: 'uptime', state: JSON.stringify(state), content, targets: lines.length } }];"
      },
