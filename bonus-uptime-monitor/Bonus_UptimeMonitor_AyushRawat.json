      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Status + response time for one target (the HTTP node already retried 3x before giving up).\nconst target = $('Stamp start time').item.json;\nconst elapsed = Date.now() - target.t0;\nconst err = $json.error;\nconst status = err ? (err.httpCode ? Number(err.httpCode) : null) : $json.statusCode;\nconst up = status === 200;\nconst reason = up ? 'HTTP 200'\n  : status ? `HTTP ${status}`\n  : String(err?.code ?? err?.message ?? 'no response').slice(0, 120);\nreturn { json: { name: target.name, url: target.url, up, status, ms: up ? elapsed : null, reason, checkedAt: new Date().toISOString() } };"
      },
